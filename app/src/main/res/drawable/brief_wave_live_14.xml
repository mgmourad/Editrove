<!-- The in-app waveform animation (each bar 35%↔100% over 450 ms, staggered), run by the
     launcher itself so it stays smooth on the home screen. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt" android:drawable="@drawable/brief_wave_14">
    <target android:name="b0">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="scaleY" android:valueFrom="0.35" android:valueTo="1" android:duration="450"
                android:startOffset="0" android:repeatCount="infinite" android:repeatMode="reverse" android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="b1">
