<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OpenWire" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Time picker for scheduled briefings, in Editrove's colours. -->
    <style name="Editrove.TimePicker" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#E11D48</item>
        <item name="android:colorPrimary">#E11D48</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
